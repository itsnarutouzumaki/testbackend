NODE_ENV=development
PORT=4000
# Replace with a random secret of at least 32 characters before starting.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
JSON_STORE_PATH=./data/store.json
FILES_STORAGE_DIR=./storage/files
# Demo data and credentials are strictly for local development. Disable in production.
ENABLE_DEMO_DATA=true
DEMO_GUARDIAN_PASSWORD=Demo@123
DEMO_TEACHER_PASSWORD=DemoTeacher@123
DEMO_ADMIN_PASSWORD=DemoAdmin@123
# Optional Expo access token. Leave blank for projects that do not require one.
EXPO_PUSH_ACCESS_TOKEN=
# Temporary debugging only. Request/response bodies are sanitized when enabled.
HTTP_DEBUG_LOGGING=false
# Keep disabled except during temporary test-data inspection outside production.
DEBUG_STORE_EXPORT_ENABLED=false
DEBUG_STORE_EXPORT_MAX_BYTES=2097152
# Testing-only browser push trigger. Requires NODE_ENV to be non-production.
DEBUG_PUSH_TEST_ENABLED=false
# Optional one-time admin bootstrap. Set all three before running npm run admin:create.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
